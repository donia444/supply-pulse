# Copy this file to .env and fill in the values. NEVER commit .env.

# --- PostgreSQL (local Docker only) ---
POSTGRES_DB=qcommerce
POSTGRES_USER=qcommerce_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Snowflake (needed for bronze-loader, dbt and Airflow) ---
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_REGION=
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=change_me
SNOWFLAKE_ROLE=your_role
SNOWFLAKE_WAREHOUSE=SUPPLY_PULSE_WH
SNOWFLAKE_DATABASE=SUPPLY_PULSE_DB
SNOWFLAKE_SCHEMA=BRONZE

# --- Optional: Slack alerts from the Airflow final_verdict task ---
SLACK_WEBHOOK_URL=

# --- Published ports ---
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8088
CONNECT_PORT=8083
DASHBOARD_PORT=8501
AIRFLOW_PORT=8080

# --- QA gate tuning (values shown are the documented defaults) ---
PRICE_MAX_INCREASE_RATIO=1.6
PRICE_MIN_DECREASE_RATIO=0.6
PRICE_JUMP_MIN_ABS_EGP=0.5
QUARANTINE_CONFIRM_COUNT=3
STALE_ACTION=dlq
DEDUP_WINDOW=16
STATEFUL_CHECKS=true
STATE_REBUILD=true
# MAX_FUTURE_SKEW_SECONDS=   # set according to your docker-compose.yml default